{
  "name": "brandon-clone",
  "account_id": "0f512227b9b4aca1ba9441dc2fa2c665",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "brandon", "database_id": "45ef15f8-631c-493f-b4cb-0cc06cb35532", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "brandon.amit.rest", "custom_domain": true }],
  "workers_dev": true,
  "vars": { "LLM_PRIMARY": "openrouter", "CHUNK_CONCURRENCY": "15" },
  "triggers": { "crons": ["0 3 * * *"] }
}
